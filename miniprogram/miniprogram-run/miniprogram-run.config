# true  = 伪 Trace：关键步骤落盘 meta/wxml/截图 → artifacts/<session>/<case>/trace/
RECORD_TRACE=true

# false = 默认不额外收尾截图
# true  = 每条用例结束后尝试 page.screenshot → artifacts/<session>/<case>/screenshot.png
RECORD_SCREENSHOT=false

# true  = 执行结束后用系统默认浏览器打开 batch HTML 报告
OPEN_HTML=true

# false = suite 失败后继续跑后续用例（同一 Session 出完整报告）
# true  = 遇失败即停，后续标 NOT_RUN（可用 suite --from 续跑）
STOP_ON_FAIL=false

# Jest reporter（扩展点，当前使用 default）
JEST_REPORTER=default
